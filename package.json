{
  "name": "hackforge",
  "version": "1.0.0",
  "description": "Hackathon planning app: analysis, deterministic rubric scoring, architecture, plan, judge and pitch.",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "node test/e2e.app.mjs",
    "build:web": "vite build && node scripts/assemble.mjs",
    "build:app": "vite build -c vite.app.config.ts",
    "android:sync": "npm run build:app && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zod": "^3.25.76"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
